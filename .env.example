# ===== WAJIB =====
# API key project Kipay (dashboard Kipay -> Projects). Bentuknya: apg_xxxxxxxx
KIPAY_API_KEY=apg_ISI_API_KEY_KIPAY_KAMU
# Secret webhook (whsec_...) — muncul SEKALI saat kamu mengisi Webhook URL di dashboard Kipay
KIPAY_WEBHOOK_SECRET=
# String acak panjang untuk menandatangani token pesanan (buat: openssl rand -hex 32)
ORDER_SECRET=ISI_TEKS_ACAK_PANJANG

# ===== WAJIB untuk produk, akun, riwayat transaksi & Admin Panel =====
# Upstash Redis — Vercel: Storage -> Marketplace -> Upstash Redis (variabel terisi otomatis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== OPSIONAL =====
# Email otomatis ke pembeli (resend.com, gratis)
RESEND_API_KEY=
MAIL_FROM=ZayyStore <noreply@domainkamu.com>
MAIL_REPLY_TO=
# Notifikasi pesanan masuk ke channel Discord admin
DISCORD_WEBHOOK_URL=

# ===== LOGIN ADMIN (WAJIB DIGANTI untuk produksi) =====
# Bila kosong, bawaan: admin122@gmail.com / admin123 (lemah & terlihat di kode — ganti!)
ADMIN_EMAIL=
ADMIN_PASSWORD=


# Email lewat Gmail sendiri (tanpa domain): aktifkan verifikasi 2 langkah lalu buat App Password
GMAIL_USER=emailkamu@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
